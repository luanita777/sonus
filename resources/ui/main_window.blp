using Gtk 4.0;
using Adw 1;

template $MainWindow : Adw.ApplicationWindow {
  default-width: 960;
  default-height: 600;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: Adw.WindowTitle {
        title: "Sonus";
      };

      [end]
      Button create_person_btn {
        label: "Crear Persona";
        icon-name: "avatar-default-symbolic";
      }

      [end]
      Button create_group_btn {
        label: "Crear Grupo";
        icon-name: "system-users-symbolic";
      }

      [end]
      Box {
        styles ["linked"]
        Button list_btn { 
            icon-name: "view-list-symbolic"; 
        }
	
        Button grid_btn { 
            icon-name: "view-grid-symbolic";         
        }
      }
    }

    content: Box {
      orientation: vertical;
      spacing: 12;
      margin-top: 12;
      margin-start: 12;
      margin-end: 12;

      Box {
        spacing: 6;
        Button btn_song { label: "Canción"; }
        Button btn_artist { label: "Artista"; }
        Button btn_genre { label: "Género"; }
        Button btn_album { label: "Álbum"; }
        
        Separator { styles ["spacer"] }

        Box {
          styles ["linked"]
          Button { label: "&&"; }
          Button { label: "||"; }
          Button { label: "-"; }
          Button { label: "("; }
          Button { label: ")"; }
          Button { label: ", "; }
        }
      }

      SearchEntry search_entry {
        placeholder-text: "Ej: song: love, artist: (John && -Travolta)";
      }

      // Stack para alternar entre la vista de Lista y Grid
      Stack main_stack {
        transition-type: crossfade;
        hexpand: true;
        vexpand: true;

        StackPage {
          name: "list";
          child: ScrolledWindow {
            child: ListView list_view {
              // Aquí irá el Factory y el modelo de datos
            };
          };
        }

        StackPage {
          name: "grid";
          child: ScrolledWindow {
            child: GridView grid_view {
              // Aquí irá el Factory y el modelo de datos
            };
          };
        }
      }
    };
  };
}

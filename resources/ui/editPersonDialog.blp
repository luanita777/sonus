using Gtk 4.0;
using Adw 1;

template $EditPersonDialog : Adw.Window {
  title: "Edit Person";
  default-width: 500;
  modal: true;
  resizable: false;

  content: Box {
    orientation: vertical;
    spacing: 18;
    margin-top: 24;
    margin-bottom: 24;
    margin-start: 24;
    margin-end: 24;

    Box {
      orientation: vertical;
      spacing: 6;
      Label {
        label: "Stage Name";
        halign: start;
        styles ["caption"] 
      }
      Entry stage_name_entry {}
    }


    Box {
      orientation: vertical;
      spacing: 6;
      Label {
        label: "Real Name";
        halign: start;
        styles ["caption"]
      }
      Entry real_name_entry {}
    }


    Box {
      spacing: 12;
      

      Box {
        orientation: vertical;
        spacing: 6;
        hexpand: true;
        Label {
          label: "Birth Date";
          halign: start;
          styles ["caption"]
        }
        MenuButton birth_date_btn {
          label: "dd / mm / yyyy";
          direction: down;
          
          popover: Popover {
            child: Box {
              orientation: vertical;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;
              spacing: 6;

              Calendar birth_date_calendar {}
            };
          };
        }
      }
      

      Box {
        orientation: vertical;
        spacing: 6;
        hexpand: true;
        Label {
          label: "Death Date";
          halign: start;
          styles ["caption"]
        }
        MenuButton death_date_btn {
          label: "dd / mm / yyyy";
          direction: down;
          
          popover: Popover {
            child: Box {
              orientation: vertical;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;
              spacing: 6;

              Calendar death_date_calendar {}
            };
          };
        }
      }
    }


    Box {
      spacing: 12;
      margin-top: 12;
      homogeneous: true; 

      Button cancel_btn {
        label: "Cancel";
      }

      Button save_btn {
        styles ["suggested-action"]
        child: Box {
          spacing: 8;
          halign: center;
          Image {
            icon-name: "document-edit-symbolic";
          }
          Label {
            label: "<b>Save Changes</b>";
            use-markup: true;
          }
        };
      }
      
    }
  };
}
